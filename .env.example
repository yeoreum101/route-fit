# 복사해서 .env 로 저장. 키가 없어도 규칙 기반 파서 + 해싱 임베딩으로 끝까지 동작한다.

# ①④ LLM (조건 파싱 · 추천 이유 생성)
# auto | off
ROUTEFIT_LLM=auto
# 제공자: gemini (무료 사용량) | openai (유료)
ROUTEFIT_LLM_PROVIDER=gemini
# Gemini 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=
# 비우면 제공자 기본 모델 (llm.py 의 PROVIDERS). 쉼표로 여러 개 적으면 앞에서부터 시도
ROUTEFIT_LLM_MODEL=

# ② 임베딩
ROUTEFIT_EMBEDDER=auto         # auto | sbert | hashing
ROUTEFIT_SBERT_MODEL=jhgan/ko-sroberta-multitask

# ③ 코스 생성기 기본값
ROUTEFIT_PLANNER=greedy        # greedy (Phase 1) | ortools (Phase 2)
