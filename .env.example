# 복사해서 .env 로 저장. 키가 없어도 규칙 기반 파서 + 해싱 임베딩으로 끝까지 동작한다.

# ①④ LLM (조건 파싱 · 추천 이유 생성)
# auto | off
ROUTEFIT_LLM=auto
# 제공자: gemini (무료 사용량) | openai (유료)
ROUTEFIT_LLM_PROVIDER=gemini
# Gemini 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=
# 비우면 제공자 기본 모델 (llm.py 의 PROVIDERS). 쉼표로 여러 개 적으면 앞에서부터 시도
ROUTEFIT_LLM_MODEL=

# ② 임베딩
ROUTEFIT_EMBEDDER=auto         # auto | sbert | hashing
ROUTEFIT_SBERT_MODEL=jhgan/ko-sroberta-multitask

# ③ 코스 생성기 기본값
ROUTEFIT_PLANNER=greedy        # greedy (Phase 1) | ortools (Phase 2)

# 데이터베이스. 비우면 data/routefit.db (SQLite, 설치 불필요)
# docker compose up -d db 로 PostgreSQL 을 띄웠다면:
# DATABASE_URL=postgresql+psycopg://routefit:routefit@localhost:5433/routefit
DATABASE_URL=
# 설정하면 /api/admin/* 에 X-Admin-Token 헤더가 필요하다. 외부에 공개하는 시연이면 반드시 설정
ROUTEFIT_ADMIN_TOKEN=
# /api/plan 요청 제한 (접속 주소당 1분에 이 횟수, 0 이면 끔). LLM 무료 사용량 보호용
ROUTEFIT_PLAN_RATE=20
# 리버스 프록시(배포) 뒤에서만 true
ROUTEFIT_TRUST_PROXY=false

# 이동시간 채우기 (python -m routefit.travel): 카카오 개발자 REST API 키, 카카오모빌리티 사용 설정
KAKAO_REST_API_KEY=

# 코스 지도를 카카오맵으로 (비우면 OpenStreetMap): 카카오 개발자 JavaScript 키.
KAKAO_JS_KEY=
